# Script Mapping Tracker (Keep local only)
script_mapping_tracker.md

# OS-specific files
.DS_Store
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# Knitted RMarkdown Reports (Ignore all HTMLs globally)
**/*.html

# Exceptions: Allow only the final interactive figures to be tracked
!**/outputs_stacked_jitter_plots/*.html
!**/outputs_stacked_jitter_plots/**/*.html
!02_targeted_cCRE_screen/outputs/sliding_window_100cells/final_plots_for_paper_main_and_supplement/*.html
!02_targeted_cCRE_screen/outputs/sliding_window_40cells/*.html

