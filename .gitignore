02_targeted_cCRE_screen/outputs/sliding_window_100cells/*
!02_targeted_cCRE_screen/outputs/sliding_window_100cells/final_plots_for_paper_main_and_supplement/
02_targeted_cCRE_screen/outputs/sliding_window_100cells/final_plots_for_paper_main_and_supplement/*
!02_targeted_cCRE_screen/outputs/sliding_window_100cells/final_plots_for_paper_main_and_supplement/*.html

